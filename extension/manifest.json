{
  "manifest_version": 3,
  "name": "Freshdesk History Cleaner",
  "author": "Noah",
  "version": "3.0",
  "description": "Extension that hides history repeats in Freshdesk responses for cleaner reading.",
  "homepage_url": "https://github.com/PatatjeMC/freshdesk-history-cleaner",
  "host_permissions": ["*://*.freshdesk.com/*"],
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.freshdesk.com/*"],
      "js": ["contentScript.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "freshdesk-history-cleaner@patatje.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
